# --- Build output ---
# One shared target/ dir at the workspace root (not per-crate), so this
# doesn't need a recursive pattern.
/target

# --- Secrets / environment ---
# .env* covers .env, .env.local, .env.production.local, etc. -- anything
# derived from .env.example that install.sh or a person fills in with real
# values. .env.example itself is intentionally NOT matched (it has no
# further extension after "example" for this pattern to catch).
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.pkcs12

# install.sh generates this from a prompted domain/IP -- environment-
# specific, not something to commit.
Caddyfile

# Local-only Docker Compose overrides (a common convention for
# machine-specific tweaks that shouldn't apply to every deployment).
docker-compose.override.yml

# --- Runtime data ---
# Default UPLOADS_DIR for `cargo run` (non-Docker) -- uploaded org/department
# seals and any other local runtime state. The Docker Compose path uses a
# named volume instead, so this only matters when running the binary directly.
/data/

# scripts/backup-db.sh/restore-db.sh only ever produce/consume *.sql.xz, but
# this guards against a BACKUP_DIR override landing a dump in-tree in any
# common dump format. Deliberately NOT a bare *.sql -- migrations/*.sql is
# tracked source, not a backup artifact.
*.sql.gz
*.sql.xz
*.dump
!/migrations/*.sql

*.log

# --- Editor / OS cruft ---
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.vscode/
.idea/
