# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=mysql://servcat:changeme@127.0.0.1:3306/servcat
SERVER_BIND_ADDR=0.0.0.0:8080

# HS256 signing secret for access/refresh JWTs. Generate with:
#   openssl rand -base64 48
JWT_SIGNING_SECRET=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# Comma-separated list of origins allowed to call the API (the web app / Tauri dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost

# Bootstrap admin created on first startup if no admin user exists yet. Set a strong
# password out-of-band and rotate/disable this account once real SSO/local admins exist.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme-change-this-immediately

# Directory uploaded org/department seals are written to and served from at
# /uploads/... (see crates/server/src/uploads.rs).
UPLOADS_DIR=data/uploads

# Seed values for org_settings, applied only the first time the server starts
# against a fresh database. Change them afterwards via PATCH /admin/settings
# (or the admin UI, once the frontend exists) rather than editing these.
APP_NAME=ServCat
# Local email/password self-registration is off (and hidden in the
# frontend) by default -- most orgs should rely on SSO and admin-created
# accounts instead. Set to true only if you actually want a public sign-up form.
ALLOW_LOCAL_SIGNUP=false

# Microsoft Entra ID (Azure AD) SSO. All five vars below must be set together
# or SSO login is disabled entirely (see AppConfig::from_env) -- leave them
# all blank/unset to run on local accounts only.
#   AZURE_REDIRECT_URI is THIS backend's own callback, registered as a
#   redirect URI on the Azure app registration (e.g.
#   https://servcat.example.com/auth/sso/callback).
#   SSO_FRONTEND_REDIRECT_URL is where the browser is sent after a
#   successful login, with a one-time handoff code appended as ?code=...
#   for the frontend to exchange at POST /auth/sso/token.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://servcat.example.com/auth/sso/callback
SSO_FRONTEND_REDIRECT_URL=https://servcat.example.com/auth/sso/complete

RUST_LOG=info,servcat=debug,sqlx=warn
